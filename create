#!/bin/sh
set -e

path=${1}
name=$(echo "${path}" | cut -d '/' -f 2)
version=${2:-latest}
tag=${3}
img=voormedia/${name}:${version}

tput setaf 2
tput bold
echo "Building and pushing image ${img}${tag:+ (also tagged ${tag})}"
tput sgr 0
# Push layers zstd-compressed: they decompress much faster than gzip on pull.
# force-compression recompresses layers inherited from gzip base images too.
docker buildx build \
--cache-from ${img} \
--cache-to type=inline \
--platform linux/amd64 \
--pull \
--tag "${img}" \
${tag:+--tag "voormedia/${name}:${tag}"} \
--build-arg "version=${version}" \
--build-arg "APK_CACHE_BUST=$(date +%Y%m%d)" \
--output type=image,push=true,oci-mediatypes=true,compression=zstd,force-compression=true \
${path}

tput setaf 2
tput bold
echo "Success!"
tput sgr 0
